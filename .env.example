# Copy to .env. Never commit .env.

# Postgres from docker-compose.yml. Change only if you moved the database.
DATABASE_URL=postgres://depbrief:depbrief@localhost:5433/depbrief

# Sent on every upstream request. Put a contact in it; the FAA and NOAA APIs ask for one.
DEPBRIEF_USER_AGENT=depbrief/0.1 (you@example.com)

# FAA NOTAM API credentials from https://api.faa.gov (free registration).
# NOTAM fetching is skipped until both are set.
FAA_NOTAM_CLIENT_ID=
FAA_NOTAM_CLIENT_SECRET=

# Optional: cache 2xx upstream responses here for five minutes during development.
# DEPBRIEF_HTTP_CACHE=cache/http

# --- Only a hosted instance needs these. See docs/deploy.md. ---
#
# Whether to believe X-Forwarded-For, and from whom. Unset, a server behind a
# proxy counts every visitor as the proxy and one of them exhausts the whole
# rate limit. Set, it believes a header the caller wrote — which is why there
# is a second cap keyed on nothing at all. `true`, or the proxy's address.
# TRUST_PROXY=true
#
# Origins allowed to call this API from a browser, comma separated. The page
# and the API are different hosts, so without this the browser refuses every
# request the page makes. Never `*`.
# DEPBRIEF_ALLOWED_ORIGINS=https://nberkyilmaz.github.io
#
# How long one upstream request may take. The default is for a METAR; the
# airport snapshot on first boot is 17 MB and main.ts raises it to a minute.
# DEPBRIEF_HTTP_TIMEOUT_MS=60000
#
# Pooled connections. A free hosted Postgres allows few of them.
# PGPOOLSIZE=8

# NOTAM relevance model. Unset means NOTAMs are fetched, decoded, filtered and
# shown, but not ranked — the deterministic half works without any model.
#   ollama  — local, the development default (install Ollama, then `ollama pull qwen2.5:7b`)
#   fixture — replay recorded answers only; what the tests and CI use
# DEPBRIEF_LLM=ollama
# OLLAMA_MODEL=qwen2.5:7b              # NOTAM relevance; use qwen2.5vl:3b for `depbrief doc wb` (it can see the page)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
#
# If Ollama's CUDA runner crashes on this machine ("device kernel image is
# invalid" — the bundled CUDA build is newer than the 546.92 driver), start
# the server on Vulkan instead:  OLLAMA_VULKAN=1 CUDA_VISIBLE_DEVICES=-1 ollama serve

# Where rendered pages and OCR of your own documents are cached (not committed).
# DEPBRIEF_DOC_CACHE=data/docs

# Record every live answer as a fixture, so tests and CI can replay it.
# DEPBRIEF_LLM_RECORD_DIR=packages/core/test/fixtures/llm/qwen2.5_7b
# DEPBRIEF_LLM_FIXTURE_DIR=packages/core/test/fixtures/llm/qwen2.5_7b

# The in-code spend ceiling, counted in output tokens per process (the second
# of the two caps; the first is the provider's own).
# DEPBRIEF_LLM_OUTPUT_TOKEN_CAP=200000
