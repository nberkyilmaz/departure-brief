# Copy to .env. Never commit .env.

# Postgres from docker-compose.yml. Change only if you moved the database.
DATABASE_URL=postgres://holdshort:holdshort@localhost:5433/holdshort

# Sent on every upstream request. Put a contact in it; the FAA and NOAA APIs ask for one.
HOLDSHORT_USER_AGENT=holdshort/0.1 (you@example.com)

# FAA NOTAM API credentials from https://api.faa.gov (free registration).
# NOTAM fetching is skipped until both are set.
FAA_NOTAM_CLIENT_ID=
FAA_NOTAM_CLIENT_SECRET=

# Optional: cache 2xx upstream responses here for five minutes during development.
# HOLDSHORT_HTTP_CACHE=cache/http

# NOTAM relevance model. Unset means NOTAMs are fetched, decoded, filtered and
# shown, but not ranked — the deterministic half works without any model.
#   ollama  — local, the development default (install Ollama, then `ollama pull qwen2.5:7b`)
#   fixture — replay recorded answers only; what the tests and CI use
# HOLDSHORT_LLM=ollama
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Record every live answer as a fixture, so tests and CI can replay it.
# HOLDSHORT_LLM_RECORD_DIR=packages/core/test/fixtures/llm/qwen2.5_7b
# HOLDSHORT_LLM_FIXTURE_DIR=packages/core/test/fixtures/llm/qwen2.5_7b

# The in-code spend ceiling, counted in output tokens per process (the second
# of the two caps; the first is the provider's own).
# HOLDSHORT_LLM_OUTPUT_TOKEN_CAP=200000
